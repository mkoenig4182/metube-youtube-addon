{
  "manifest_version": 3,
  "name": "Send to MeTube",
  "version": "1.0.0",
  "description": "Fügt einen Button auf YouTube ein, um Videos direkt an die eigene MeTube-Instanz zu senden.",
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "https://ytdl.marcelkoenig.de/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/watch?*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "action": {
    "default_icon": "icon128.png"
  }
}